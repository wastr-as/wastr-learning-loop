# Python artefacts
__pycache__/
*.pyc

# Transcripts and source recordings are captured into Notion, not committed here.
output/
*.m4a
*.mp3
*.wav
*.mp4
*.mov
*.webm

# Recordings dropped into the input/ folder — keep the folder structure and docs,
# ignore everything else that lands there.
input/*
!input/README.md
!input/founders/
!input/customer/
!input/partner/
input/founders/*
!input/founders/.gitkeep
input/customer/*
!input/customer/.gitkeep
input/partner/*
!input/partner/.gitkeep
